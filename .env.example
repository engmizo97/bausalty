# NextAuth / Auth.js Configuration
# A secure, random 32-character string used to encrypt session tokens.
# You can generate one by running: openssl rand -base64 32
AUTH_SECRET="your_auth_secret_here"

# The base URL of your site (required for Auth.js in local/production)
# Local: http://localhost:3000
# Production: https://bausalty.com (or your specific domain)
NEXTAUTH_URL="http://localhost:3000"

# Google Cloud OAuth Credentials
# Generated via Google Cloud Console -> APIs & Services -> Credentials
GOOGLE_CLIENT_ID="your_google_client_id_here"
GOOGLE_CLIENT_SECRET="your_google_client_secret_here"

# SendGrid Email Integration (Optional)
# If used for sending notifications or magic links
SENDGRID_API_KEY="your_sendgrid_api_key_here"
SENDGRID_FROM_EMAIL="noreply@yourdomain.com"
